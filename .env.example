# Resend API key for contact form emails
RESEND_API_KEY=re_your_api_key_here

# From address for lead notification emails
# Set this after verifying your domain in Resend
LEAD_FROM_EMAIL=leads@forgefranchising.com

# Client facing sender for the proposal confirmation email.
# Must be on a domain verified in Resend. Falls back to LEAD_FROM_EMAIL.
CLIENT_FROM_EMAIL=
